# FlexGain environment variables
#
# Copy this file to `.env.local` for local development.
# `next dev` will load it automatically.

# --- Required in production ---
# Secret used to sign session JWTs (HS256). Must be >= 16 chars.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-16-chars

# Postgres connection string. Required — the app has no in-memory
# fallback (in-memory data does not survive across serverless
# invocations, e.g. on Vercel).
# Local Docker Compose: postgres://flexgain:flexgain@localhost:5433/flexgain?sslmode=disable
# Hosted (Neon/Supabase/Vercel Postgres): use the connection string they give you.
DATABASE_URL=postgres://flexgain:flexgain@localhost:5433/flexgain?sslmode=disable

# Set to "0" to skip creating the demo@flexgain.app seed account.
# FLEXGAIN_SEED=0

# --- Optional ---
# Max Postgres connections per instance (default 3). Each serverless
# instance keeps its own pool, so this multiplies by the number of warm
# instances — raise it only if your database has headroom.
# DATABASE_POOL_MAX=3

# Set to "1" to accept any database TLS certificate. Verification is on by
# default and works with Neon, Supabase and Vercel Postgres. Only needed
# for a provider using a private CA, and it makes the connection
# interceptable — prefer NODE_EXTRA_CA_CERTS pointed at their root cert.
# DATABASE_SSL_NO_VERIFY=1

# --- AI features (optional) ---
# Google Gemini API key. Without it the app runs normally and every AI
# feature is hidden: exercise auto-fill, the AI Coach page and AI nutrition
# targets. Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key-here

# Model to use. Defaults to gemini-2.5-flash, which is fast, cheap and good
# at the schema-constrained JSON these features rely on.
# GEMINI_MODEL=gemini-2.5-flash
