# FlexGain environment variables
#
# Copy this file to `.env.local` for local development.
# `next dev` will load it automatically.

# --- Required in production ---
# Secret used to sign session JWTs (HS256). Must be >= 16 chars.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-16-chars

# Postgres connection string. Required — the app has no in-memory
# fallback (in-memory data does not survive across serverless
# invocations, e.g. on Vercel).
# Local Docker Compose: postgres://flexgain:flexgain@localhost:5433/flexgain?sslmode=disable
# Hosted (Neon/Supabase/Vercel Postgres): use the connection string they give you.
DATABASE_URL=postgres://flexgain:flexgain@localhost:5433/flexgain?sslmode=disable

# Set to "0" to skip creating the demo@flexgain.app seed account.
# FLEXGAIN_SEED=0

# --- Optional ---
# Override the cookie domain (default = current host).
# SESSION_COOKIE_DOMAIN=flexgain.example.com
