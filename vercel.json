{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/api/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, max-age=3600" }
      ]
    }
  ]
}
